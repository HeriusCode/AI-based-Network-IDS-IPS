    padding: 5px 11px;
    color: #E5E2F3;
    font-size: 11px;
}

QPushButton#activeRuleTab,
QPushButton#ruleTab {
    min-height: 32px;
    border-radius: 8px;
    padding: 0 12px;
    font-size: 11px;
}

QPushButton#activeRuleTab {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    color: #FFFFFF;
    font-weight: 700;
}

QPushButton#ruleTab {
    background: #1B1938;
    border: 1px solid #282452;
    color: #8E8BA7;
    font-weight: 500;
}

QPushButton#ruleTab:hover {
    background: #25224D;
    color: #FFFFFF;
}

#ruleFormLabel {
    color: #9E9BB5;
    font-size: 11px;
    font-weight: 500;
}

QLineEdit#ruleInput,
QComboBox#ruleFormCombo {
    min-height: 32px;
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 8px;
    padding: 0 10px;
    color: #FFFFFF;
    font-size: 11px;
}

