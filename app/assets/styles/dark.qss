/* ========================================================================= */
/* SMARTNET MIDNIGHT INDIGO & ELECTRIC PURPLE THEME                          */
/* AI-based Network IDS/IPS SOC Platform                                     */
/* ========================================================================= */

* {
    font-family: "Segoe UI", "Inter", sans-serif;
    color: #E5E2F3;
}

QMainWindow,
#rightPane,
#pageContent,
#pageScroll,
#dashboardContent,
#dashboardScroll,
#monitorContent,
#monitorScroll,
#detectionContent,
#detectionScroll,
#predictionContent,
#predictionScroll,
#mitigationContent,
#mitigationScroll,
#topologyContent,
#topologyScroll,
#alertsContent,
#alertsScroll,
#reportsContent,
#reportsScroll,
#settingsContent,
#settingsScroll {
    background: #131129;
}

#appRoot {
    background: #131129;
    border: 1px solid #232047;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: #0F0E21;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2B2754;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #6C5DD3;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

/* ========================================================================= */
/* SIDEBAR (Midnight Violet với nút Active Electric Purple Pill)             */
/* ========================================================================= */
#sidebar {
    background: #0F0E21;
    border-right: 1px solid #1E1C3C;
}

#sidebarBrandContainer {
    background: transparent;
}

#brandText {
    font-size: 22px;
    font-weight: 800;
    color: #FFFFFF;
    letter-spacing: 1.2px;
}

#brandSubtitle {
    font-size: 10.5px;
    font-weight: 600;
    color: #A78BFA;
    letter-spacing: 0.8px;
}

#brandSlogan {
    background: rgba(108, 93, 211, 0.12);
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 10px;
    padding: 7px 10px;
    color: #DDD6FE;
    font-size: 11px;
    font-weight: 500;
    font-style: italic;
    letter-spacing: 0.2px;
}

#sidebarScroll,
#sidebarNavContent {
    background: transparent;
    border: none;
}

#sidebarDivider {
    background: #1E1C3C;
    border: none;
    margin: 0 14px;
}

QPushButton#navButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
    color: #8E8BA7;
    text-align: left;
    padding: 0 16px;
    margin: 3px 12px;
    font-size: 14px;
    font-weight: 500;
    min-height: 48px;
    max-height: 48px;
}

QPushButton#navButton:hover {
    background: #1C1938;
    border-color: #2D2958;
    color: #FFFFFF;
}

QPushButton#navButton[active="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 14px;
}

QPushButton#navButton[collapsed="true"] {
    padding: 0;
    text-align: center;
    margin: 3px 10px;
}

#accountCard {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 18px;
    margin: 6px 12px;
}

#avatar {
    background: #25224D;
    border: 1px solid #6C5DD3;
    border-radius: 22px;
}

#accountName {
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
}

#accountRole {
    font-size: 11.5px;
    font-weight: 500;
    color: #A78BFA;
}

#accountText {
    font-size: 13px;
    font-weight: 600;
    color: #F1F5F9;
}

#accountText span {
    color: #A78BFA;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#sidebarCollapse {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 10px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
}

QPushButton#sidebarCollapse:hover {
    background: #25224D;
    border-color: #6C5DD3;
}

QPushButton#sidebarLogout {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
}

QPushButton#sidebarLogout:hover {
    background: rgba(239, 68, 68, 0.16);
    border-color: rgba(239, 68, 68, 0.45);
}

/* ========================================================================= */
/* TOPBAR                                                                    */
/* ========================================================================= */
#topbar {
    background: #0F0E21;
    border-bottom: 1px solid #1E1C3C;
}

#liveStatus {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.32);
    border-radius: 14px;
    padding: 3px 14px;
    font-size: 11px;
    font-weight: 600;
    color: #34D399;
}

#onlineStatus {
    background: rgba(108, 93, 211, 0.16);
    border: 1px solid rgba(108, 93, 211, 0.38);
    border-radius: 14px;
    padding: 3px 14px;
    font-size: 11px;
    font-weight: 600;
    color: #A78BFA;
}

#topbarClockCard {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 14px;
}

#topbarClock {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
}

#topbarDate {
    color: #8E8BA7;
    font-size: 9px;
    font-weight: 500;
}

#topbarSeparator {
    background: #232047;
    border: none;
    max-width: 1px;
}

QPushButton#topIconButton {
    background: #1B1938;
    border: 1px solid #282452;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    border-radius: 12px;
}

QPushButton#topIconButton:hover {
    background: #25224D;
    border-color: #6C5DD3;
}

QPushButton#windowButton,
QPushButton#closeWindowButton {
    background: transparent;
    border: none;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border-radius: 8px;
}

QPushButton#windowButton:hover {
    background: #221F48;
}

QPushButton#closeWindowButton:hover {
    background: #DC2626;
}

/* ========================================================================= */
/* DASHBOARD (Bo tròn các khối 20px, tông nền thẻ tím than sâu sang trọng)     */
/* ========================================================================= */
#dashboardHeading {
    color: #FFFFFF;
    font-size: 27px;
    font-weight: 700;
}

#dashboardSubheading {
    color: #8E8BA7;
    font-size: 12px;
    padding-bottom: 5px;
}

#dashboardMasterFrame {
    background: #171530;
    border: 1px solid #282452;
    border-radius: 20px;
}

#dashboardMasterFrame:hover {
    border-color: #383266;
}

#masterSectionTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
}

#masterSectionSubtitle {
    color: #8E8BA7;
    font-size: 11px;
}

#subCard,
#metricCard,
#dashboardPanel {
    background: #1E1B40;
    border: 1px solid #2B2757;
    border-radius: 16px;
}

#subCard:hover,
#metricCard:hover,
#dashboardPanel:hover {
    border-color: #4D4587;
}

#subMetricCard {
    background: #1E1B40;
    border: 1px solid #2B2757;
    border-radius: 14px;
}

#subMetricCard:hover {
    border-color: #554D94;
    background: #23204B;
}

#metricIcon {
    background: #25224D;
    border-radius: 14px;
}

#metricTitle {
    color: #9E9BB5;
    font-size: 11px;
    font-weight: 500;
}

#metricValue {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
}

#metricChange {
    font-size: 10px;
    font-weight: 600;
}

#systemGood {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
}

QProgressBar#healthProgress {
    background: #25224D;
    border: none;
    border-radius: 5px;
}

QProgressBar#healthProgress::chunk {
    background: #10B981;
    border-radius: 5px;
}

#panelTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
}

#panelSubtitle {
    color: #8E8BA7;
    font-size: 11px;
    font-weight: 500;
}

#liveBadge {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.32);
    border-radius: 16px;
    padding: 5px 14px;
    color: #34D399;
    font-weight: 600;
    font-size: 11px;
}

#panelChip {
    background: #25224D;
    border: 1px solid #383466;
    border-radius: 10px;
    padding: 4px 10px;
    color: #C4B5FD;
    font-size: 11px;
    font-weight: 600;
}

#legendLabel {
    color: #8E8BA7;
    font-size: 11px;
}

#legendValue {
    color: #E5E2F3;
    font-size: 11px;
}

QTableWidget#dashboardTable,
QTableWidget#detectionTable,
QTableWidget#predictionTable,
QTableWidget#ruleTable,
QTableWidget#deviceTable,
QTableWidget#alertsTable,
QTableWidget#reportsTable,
QTableWidget#logsTable {
    background: transparent;
    alternate-background-color: transparent;
    border: none;
    color: #CBD5E1;
    font-size: 11px;
    selection-background-color: #2D255E;
    selection-color: #FFFFFF;
}

QTableWidget#dashboardTable::item,
QTableWidget#detectionTable::item,
QTableWidget#predictionTable::item,
QTableWidget#ruleTable::item,
QTableWidget#deviceTable::item,
QTableWidget#alertsTable::item,
QTableWidget#reportsTable::item,
QTableWidget#logsTable::item {
    border-bottom: 1px solid #24204A;
    padding: 4px 6px;
}

QTableWidget#dashboardTable::item:selected,
QTableWidget#dashboardTable::item:selected:active,
QTableWidget#dashboardTable::item:selected:!active,
QTableWidget#detectionTable::item:selected,
QTableWidget#detectionTable::item:selected:active,
QTableWidget#detectionTable::item:selected:!active,
QTableWidget#predictionTable::item:selected,
QTableWidget#predictionTable::item:selected:active,
QTableWidget#predictionTable::item:selected:!active,
QTableWidget#ruleTable::item:selected,
QTableWidget#ruleTable::item:selected:active,
QTableWidget#ruleTable::item:selected:!active,
QTableWidget#deviceTable::item:selected,
QTableWidget#deviceTable::item:selected:active,
QTableWidget#deviceTable::item:selected:!active,
QTableWidget#alertsTable::item:selected,
QTableWidget#alertsTable::item:selected:active,
QTableWidget#alertsTable::item:selected:!active,
QTableWidget#reportsTable::item:selected,
QTableWidget#reportsTable::item:selected:active,
QTableWidget#reportsTable::item:selected:!active,
QTableWidget#logsTable::item:selected,
QTableWidget#logsTable::item:selected:active,
QTableWidget#logsTable::item:selected:!active {
    background-color: #2D255E;
    color: #FFFFFF;
}

QTableWidget#dashboardTable::item:selected:hover,
QTableWidget#detectionTable::item:selected:hover,
QTableWidget#predictionTable::item:selected:hover,
QTableWidget#ruleTable::item:selected:hover,
QTableWidget#deviceTable::item:selected:hover,
QTableWidget#alertsTable::item:selected:hover,
QTableWidget#reportsTable::item:selected:hover,
QTableWidget#logsTable::item:selected:hover {
    background-color: #382E72;
}

QHeaderView,
QHeaderView::section,
QHeaderView::section:horizontal,
QHeaderView::section:vertical,
QTableCornerButton::section {
    background: #181533;
    background-color: #181533;
}

QHeaderView {
    background: #181533;
    background-color: #181533;
    border: none;
    border-bottom: 1px solid #282452;
}

QHeaderView::section {
    background: #181533;
    background-color: #181533;
    color: #9E9BB5;
    border: none;
    border-bottom: 1px solid #282452;
    padding: 8px 8px;
    font-size: 11px;
    font-weight: 600;
}

QTableCornerButton::section {
    background: #181533;
    background-color: #181533;
    border: none;
}

#moduleCard {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 18px;
}

#moduleCard:hover {
    border-color: #4D4587;
}

#moduleIcon {
    background: rgba(16, 185, 129, 0.15);
    border-radius: 14px;
}

#moduleTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

#moduleSubtitle {
    color: #8E8BA7;
    font-size: 11px;
}

#moduleState {
    color: #34D399;
    font-size: 11px;
}

/* ========================================================================= */
/* PLACEHOLDER PAGES                                                         */
/* ========================================================================= */
#eyebrow {
    color: #8B5CF6;
    font-size: 11px;
    font-weight: 700;
}

#pageHeading {
    font-size: 27px;
    font-weight: 700;
    color: #FFFFFF;
}

#pageDescription,
#panelDescription {
    color: #8E8BA7;
    font-size: 13px;
}

#welcomePanel,
#featureCard {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 20px;
}

#welcomePanel:hover,
#featureCard:hover {
    border-color: #4D4587;
}

#readyBadge,
#phaseBadge {
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 10px;
    font-weight: 700;
}

#readyBadge {
    background: rgba(16, 185, 129, 0.16);
    color: #34D399;
}

#phaseBadge {
    background: rgba(108, 93, 211, 0.2);
    color: #A78BFA;
}

#panelHeading {
    font-size: 22px;
    font-weight: 700;
    color: #FFFFFF;
}

#featureNumber {
    color: #8B5CF6;
    font-size: 12px;
    font-weight: 700;
}

#featureName {
    color: #E2E8F0;
    font-size: 13px;
    font-weight: 600;
}

#footerLabel {
    color: #6E6A94;
    font-size: 10px;
}

/* ========================================================================= */
/* NETWORK MONITORING                                                        */
/* ========================================================================= */
#monitorHeading {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

#monitorSubtitle {
    color: #8E8BA7;
    font-size: 11.5px;
    font-weight: 400;
}

#controlLabel {
    color: #8E8BA7;
    font-size: 10px;
}

#monitorPanel {
    background: #1E1B40;
    border: 1px solid #2B2757;
    border-radius: 16px;
}

#monitorMetric {
    background: #1E1B40;
    border: 1px solid #2B2757;
    border-radius: 14px;
}

#monitorMetric:hover,
#monitorPanel:hover {
    border-color: #4D4587;
}

#monitorMetricIcon {
    background: #25224D;
    border-radius: 14px;
}

#monitorMetricTitle {
    color: #9E9BB5;
    font-size: 11px;
}

#monitorMetricValue {
    color: #FFFFFF;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

#monitorMetricChange {
    font-size: 10px;
    font-weight: 600;
}

#monitorPanelTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
}

#monitorLegend {
    color: #8E8BA7;
    font-size: 9px;
}

QComboBox#monitorCombo,
QComboBox#flowCombo {
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 12px;
    padding: 7px 12px;
    color: #E5E2F3;
    font-size: 10px;
}

QComboBox#monitorCombo {
    min-width: 130px;
}

QComboBox#flowCombo {
    min-width: 102px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #1B1938;
    border: 1px solid #2D2958;
    selection-background-color: #6C5DD3;
    border-radius: 8px;
}

QPushButton#primaryMonitorButton,
QPushButton#monitorButton,
QPushButton#smallMonitorButton {
    min-height: 36px;
    border-radius: 12px;
    padding: 0 14px;
    font-size: 10.5px;
    font-weight: 600;
}

QPushButton#primaryMonitorButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    color: #FFFFFF;
}

QPushButton#primaryMonitorButton:hover {
    background: #7B61FF;
}

QPushButton#monitorButton,
QPushButton#smallMonitorButton {
    background: #1B1938;
    border: 1px solid #282452;
    color: #C5BFDB;
}

QPushButton#monitorButton:hover,
QPushButton#smallMonitorButton:hover {
    background: #25224D;
    border-color: #6C5DD3;
    color: #FFFFFF;
}

QLineEdit#flowSearch {
    min-width: 190px;
    min-height: 33px;
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 12px;
    padding: 0 11px;
    font-size: 10px;
    color: #FFFFFF;
}

QLineEdit#flowSearch:focus {
    border: 1px solid #6C5DD3;
    background: #191735;
}

QTableWidget#flowTable {
    background: transparent;
    border: none;
    color: #C8D5E4;
    font-size: 9px;
}

QTableWidget#flowTable::item {
    border-bottom: 1px solid #24204A;
    padding: 4px 5px;
}

QTableWidget#flowTable::item:selected {
    background: #2D2760;
}

#flowFooter {
    color: #8E8BA7;
    font-size: 9px;
}

QPushButton#pageButton,
QPushButton#activePage {
    min-width: 29px;
    max-width: 29px;
    min-height: 29px;
    border-radius: 8px;
    font-size: 9.5px;
}

QPushButton#pageButton {
    background: #1B1938;
    border: 1px solid #282452;
    color: #8E8BA7;
}

QPushButton#pageButton:hover {
    background: #25224D;
    color: #FFFFFF;
}

QPushButton#activePage {
    background: #6C5DD3;
    border: 1px solid #7B61FF;
    color: #FFFFFF;
    font-weight: 600;
}

#interfaceCard {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 14px;
}

#interfaceName {
    color: #FFFFFF;
    font-size: 10.5px;
    font-weight: 600;
}

#interfaceUp {
    color: #34D399;
    background: rgba(16, 185, 129, 0.14);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 7px;
    padding: 2px 8px;
    font-size: 9px;
}

#interfaceSpeed {
    color: #A78BFA;
    font-size: 9px;
}

#ipLabel,
#ipValue {
    color: #8E8BA7;
    font-size: 9px;
}

QProgressBar#ipBar {
    background: #25224D;
    border: none;
    border-radius: 5px;
}

/* ========================================================================= */
/* ANOMALY DETECTION                                                         */
/* ========================================================================= */
#detectionHeading {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

#detectionSubtitle {
    color: #8E8BA7;
    font-size: 11.5px;
}

QPushButton#dateRangeButton {
    min-height: 36px;
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 10px;
    color: #E5E2F3;
    font-size: 11px;
    text-align: left;
    padding: 0 12px;
}

QPushButton#dateRangeButton:hover {
    background: #25224D;
    border-color: #6C5DD3;
}

QPushButton#detectionRefresh {
    min-height: 36px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
    padding: 0 14px;
}

QPushButton#detectionRefresh:hover {
    background: #7B61FF;
}

#attackLegend {
    color: #8E8BA7;
    font-size: 11px;
}

QLineEdit#detectionSearch {
    min-width: 140px;
    min-height: 34px;
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 10px;
    padding: 0 11px;
    font-size: 11px;
    color: #FFFFFF;
}

QLineEdit#detectionSearch:focus {
    border: 1px solid #6C5DD3;
    background: #191735;
}

QComboBox#detectionCombo {
    min-width: 125px;
    min-height: 34px;
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 10px;
    padding: 5px 12px;
    color: #E5E2F3;
    font-size: 11px;
}

#detectionDetail {
    background: #1E1B40;
    border: 1px solid #2B2757;
    border-radius: 16px;
}

#detectionDetail:hover {
    border-color: #4D4587;
}

#detailAlert {
    color: #FF5B79;
    background: rgba(255, 91, 121, 0.14);
    border: 1px solid rgba(255, 91, 121, 0.35);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 14px;
    font-weight: 800;
}

#detailSeparator {
    background: #282452;
    border: none;
}

#detailKey {
    color: #8E8BA7;
    font-size: 12.5px;
    font-weight: 500;
}

#detailValue {
    color: #FFFFFF;
    font-size: 12.5px;
    font-weight: 600;
}

#detailSectionTitle {
    color: #C4B5FD;
    font-size: 12.5px;
    font-weight: 700;
    padding-top: 4px;
}

#detailDescription {
    color: #D6D2EC;
    font-size: 12px;
    line-height: 1.5;
}

QProgressBar#confidenceBar {
    background: #25224D;
    border: none;
    border-radius: 4px;
}

QProgressBar#confidenceBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #10B981, stop:1 #34D399);
    border-radius: 4px;
}

QPushButton#blockIpButton,
QPushButton#viewDetailButton {
    min-height: 40px;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#blockIpButton {
    background: #DC2626;
    border: 1px solid #EF4444;
    color: #FFFFFF;
}

QPushButton#blockIpButton:hover {
    background: #EF4444;
}

QPushButton#blockIpButton:disabled {
    background: #3D2935;
    color: #7B6873;
    border-color: #4D3442;
}

QPushButton#viewDetailButton {
    background: #1B1938;
    border: 1px solid #282452;
    color: #A78BFA;
}

QPushButton#viewDetailButton:hover {
    background: #25224D;
    border-color: #6C5DD3;
}

/* ========================================================================= */
/* TRAFFIC PREDICTION                                                        */
/* ========================================================================= */
#predictionHeading {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 700;
}

#predictionSubtitle {
    color: #8E8BA7;
    font-size: 12px;
    padding-bottom: 4px;
}

#predictionSummary {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 20px;
}

#predictionPanelTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
}

#predictionSummaryRow {
    border-bottom: 1px solid #24204A;
}

#predictionIcon {
    background: #25224D;
    border-radius: 12px;
}

#predictionLabel {
    color: #8E8BA7;
    font-size: 9.5px;
}

#predictionValue {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 700;
}

#predictionDelta {
    color: #FF5B79;
    font-size: 9.5px;
}

QLineEdit#predictionSearch {
    min-width: 140px;
    min-height: 34px;
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 10px;
    padding: 0 11px;
    font-size: 11px;
    color: #FFFFFF;
}

QLineEdit#predictionSearch:focus {
    border: 1px solid #6C5DD3;
    background: #191735;
}

QPushButton#predictionRefresh {
    min-height: 36px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
    padding: 0 14px;
}

QPushButton#predictionRefresh:hover {
    background: #7B61FF;
}

QComboBox#predictionCombo {
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 10px;
    padding: 5px 12px;
    color: #E5E2F3;
    font-size: 11px;
    min-width: 125px;
    min-height: 34px;
}

QComboBox#predictionCombo QAbstractItemView {
    background: #1B1938;
    border: 1px solid #2D2958;
    selection-background-color: #6C5DD3;
    color: #FFFFFF;
    padding: 4px;
}

#settingLabel {
    color: #8E8BA7;
    font-size: 11px;
    min-width: 85px;
    font-weight: 500;
}

QPushButton#startPredictionButton {
    min-height: 38px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    border-radius: 10px;
    color: #FFFFFF;
    font-size: 11.5px;
    font-weight: 700;
}

QPushButton#startPredictionButton:hover {
    background: #7B61FF;
}

QPushButton#startPredictionButton:disabled {
    background: #25214E;
    color: #716C97;
    border-color: #38326D;
}

