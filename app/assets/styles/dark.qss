    color: #FFFFFF;
}

QPushButton#addRuleButton:hover {
    background: #7B61FF;
}

QPushButton#resetRuleButton {
    background: #1B1938;
    border: 1px solid #282452;
    color: #C4B5FD;
}

QPushButton#resetRuleButton:hover {
    background: #25224D;
    border-color: #6C5DD3;
    color: #FFFFFF;
}

#ruleFormStatus {
    font-size: 10.5px;
    color: #FF5B79;
}

#ruleFormStatus[valid="true"] {
    color: #34D399;
}

#historyRow {
    border-bottom: 1px solid #24204A;
}

#historyIcon {
    background: #25224D;
    border-radius: 10px;
}

#historyTitle {
    color: #FFFFFF;
    font-size: 11.5px;
    font-weight: 600;
}

#historyTime {
    color: #8E8BA7;
    font-size: 10.5px;
}

