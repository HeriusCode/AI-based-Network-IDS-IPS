QComboBox#ruleFormCombo:focus {
    border: 1px solid #6C5DD3;
    background: #191735;
}

QComboBox#ruleFormCombo {
    padding: 4px 10px;
}

QPushButton#addRuleButton,
QPushButton#resetRuleButton {
    min-height: 36px;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 11.5px;
    font-weight: 700;
}

QPushButton#addRuleButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
