* { font-family: "Segoe UI", "Inter", sans-serif; color: #E7EEF8; }
QMainWindow, #rightPane, #pageContent, #pageScroll,
#dashboardContent, #dashboardScroll { background: #071423; }
#appRoot { background: #071423; border: 1px solid #29445D; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #071423; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #2B4059; border-radius: 4px; min-height: 32px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

#sidebar { background: #091827; border-right: 1px solid #1D344A; }
#brandText { font-size: 16px; font-weight: 700; color: #F5F8FC; }
#brandText span { font-size: 9px; font-weight: 400; color: #A0B0C6; }
#sidebarDivider { background: #173047; border: none; margin: 0 22px; }
QPushButton#navButton {
    background: transparent; border: none; border-left: 4px solid transparent;
    color: #D2DEED; text-align: left; padding: 0 24px; font-size: 13px; font-weight: 500;
}
QPushButton#navButton:hover { background: #102A43; color: #FFFFFF; }
QPushButton#navButton[active="true"] {
    background: #145BAC; border-left-color: #3FAAFF; color: #FFFFFF; font-weight: 600;
}
#accountCard { background: transparent; border: none; }
#avatar { background: #273A52; border-radius: 23px; }
#accountText { font-size: 12px; font-weight: 600; }
#accountText span { color: #8FA3BC; font-size: 10px; font-weight: 400; }
QPushButton#sidebarCollapse { background: transparent; border: none; min-width: 30px; min-height: 34px; }
QPushButton#sidebarCollapse:hover { background: #183149; border-radius: 7px; }

#topbar { background: #091827; border-bottom: 1px solid #1D344A; }
QLineEdit#globalSearch {
    min-height: 36px; padding: 0 12px; background: #101F31; border: 1px solid #294058;
    border-radius: 8px; color: #DDE9F6; font-size: 12px;
}
QLineEdit#globalSearch:focus { border-color: #3B9FFF; }
#liveStatus, #onlineStatus { background: #0C1C2D; border-radius: 6px; padding: 0 7px; font-size: 9px; }
#liveStatus { color: #31DE91; }
#onlineStatus { color: #62BBFF; }
#topbarSeparator { background: #1D344A; border: none; }
#topbarClock { color: #BFD3EA; font-size: 11px; font-weight: 600; }
#topbarDate { color: #8196B1; font-size: 8px; }
QPushButton#topIconButton { background: transparent; border: none; min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px; border-radius: 7px; }
QPushButton#topIconButton:hover { background: #172C42; }
QPushButton#windowButton, QPushButton#closeWindowButton {
    background: transparent; border: none; min-width: 31px; max-width: 31px;
    min-height: 34px; max-height: 34px; border-radius: 5px;
}
QPushButton#windowButton:hover { background: #1B334A; }
QPushButton#closeWindowButton:hover { background: #D84252; }

#dashboardHeading { color: #F5F8FC; font-size: 27px; font-weight: 700; }
#dashboardSubheading { color: #93A6BF; font-size: 12px; padding-bottom: 5px; }
#metricCard, #dashboardPanel { background: #0D1D2E; border: 1px solid #1C3851; border-radius: 10px; }
#metricCard:hover, #dashboardPanel:hover { border-color: #285374; }
#metricIcon { background: #132D4C; border-radius: 13px; }
#metricTitle { color: #AAB9CB; font-size: 10px; }
#metricValue { color: #F6F9FC; font-size: 19px; font-weight: 700; }
#metricChange { font-size: 10px; font-weight: 600; }
#systemGood { color: #F5F8FC; font-size: 14px; font-weight: 700; }
QProgressBar#healthProgress { background: #18304A; border: none; border-radius: 4px; }
QProgressBar#healthProgress::chunk { background: #21D98A; border-radius: 4px; }
#panelTitle { color: #F4F7FB; font-size: 14px; font-weight: 700; }
#legendLabel { color: #A8B7CA; font-size: 10px; }
#legendValue { color: #E9EFF7; font-size: 10px; }

QTableWidget#dashboardTable { background: transparent; alternate-background-color: #0A1929; border: none; color: #CAD6E5; font-size: 10px; }
QTableWidget#dashboardTable::item { border-bottom: 1px solid #183047; padding: 4px 5px; }
QHeaderView::section { background: #102236; color: #91A5BF; border: none; border-bottom: 1px solid #1D3A54; padding: 7px 5px; font-size: 10px; }

#moduleCard { background: #102236; border: 1px solid #1B3A55; border-radius: 9px; }
#moduleIcon { background: #084C40; border-radius: 13px; }
#moduleTitle { color: #EAF0F7; font-size: 11px; font-weight: 600; }
#moduleSubtitle { color: #9AAEC6; font-size: 10px; }
#moduleState { color: #20E19A; font-size: 9px; }

/* Placeholder pages */
#eyebrow { color: #60A5FA; font-size: 10px; font-weight: 700; }
#pageHeading { font-size: 27px; font-weight: 700; }
#pageDescription, #panelDescription { color: #94A3B8; font-size: 13px; }
#welcomePanel, #featureCard { background: #0D1D2E; border: 1px solid #1C3851; border-radius: 10px; }
#readyBadge, #phaseBadge { border-radius: 7px; padding: 7px 10px; font-size: 10px; font-weight: 700; }
#readyBadge { background: #123A31; color: #4ADE80; }
#phaseBadge { background: #15365A; color: #93C5FD; }
#panelHeading { font-size: 22px; font-weight: 700; }
#featureNumber { color: #60A5FA; font-size: 11px; font-weight: 700; }
#featureName { color: #CBD5E1; font-size: 12px; font-weight: 600; }
#footerLabel { color: #64748B; font-size: 10px; }
