/* ACCOUNT REGISTRATION & LOGIN                                              */
/* ========================================================================= */
#registerRoot,
#loginRoot {
    background: #110F24;
    border: 1px solid #282452;
}

#authTitleBar {
    background: #0D0C1D;
    border-bottom: 1px solid #1E1C3C;
}

#authBrandName {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#authWindowButton,
QPushButton#authCloseButton {
    background: transparent;
    border: none;
    min-width: 39px;
    max-width: 39px;
    min-height: 38px;
    max-height: 38px;
    border-radius: 8px;
}

QPushButton#authWindowButton:hover {
    background: #221F48;
}

QPushButton#authCloseButton:hover {
    background: #DC2626;
}

#registerCard,
#loginCard {
    background: rgba(27, 25, 56, 0.96);
    border: 1px solid #38326D;
    border-radius: 24px;
}

#registerBrandPanel {
    background: rgba(22, 20, 46, 0.85);
    border-right: 1px solid #282452;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
}

#registerFormScroll,
#registerFormScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}

#registerFormScroll QScrollBar:vertical {
    background: #15132B;
    width: 7px;
    margin: 4px 0;
}

#registerFormScroll QScrollBar::handle:vertical {
    background: #3B3673;
    min-height: 28px;
    border-radius: 3px;
}

#registerFormPanel {
    background: rgba(27, 25, 56, 0.96);
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
}

#registerProductTitle,
#loginProductTitle {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: 700;
}

#registerProductSubtitle,
#loginProductSubtitle {
    color: #A78BFA;
    font-size: 13.5px;
}

#registerFeatureIcon,
#loginFeatureIcon {
    background: #25224D;
    border: 1px solid #6C5DD3;
    border-radius: 32px;
}

#registerFeatureText,
#loginFeatureText {
    color: #D6D2EC;
    font-size: 11.5px;
    line-height: 1.35;
}

#registerQuote,
#loginQuote {
    color: #C4B5FD;
    background: transparent;
    border: none;
    font-size: 12.5px;
    font-style: italic;
    padding: 2px 6px;
}

#registerHeading,
#loginHeading {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 700;
}

#registerSubheading,
#loginSubheading {
    color: #8E8BA7;
    font-size: 12px;
}

#registerFieldLabel,
#loginFieldLabel {
    color: #C5BFDB;
    font-size: 11.5px;
}

QLineEdit#registerInput,
QLineEdit#loginInput {
    background: #15132B;
    border: 1px solid #282452;
    border-radius: 12px;
    color: #FFFFFF;
    padding: 0 14px;
    font-size: 11.5px;
}

QLineEdit#registerInput {
    min-height: 44px;
}

QLineEdit#loginInput {
    min-height: 50px;
}

QLineEdit#registerInput:focus,
QLineEdit#loginInput:focus {
    border: 1px solid #6C5DD3;
    background: #191735;
}

QLineEdit#registerInput::placeholder,
QLineEdit#loginInput::placeholder {
    color: #6E6A94;
}

QCheckBox#loginRemember {
    color: #C5BFDB;
    font-size: 11px;
    spacing: 9px;
}

QCheckBox#loginRemember::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #38326D;
    border-radius: 5px;
    background: #15132B;
}

QCheckBox#loginRemember::indicator:checked {
    background: #6C5DD3;
    border-color: #7B61FF;
    image: url(none);
}

QPushButton#loginForgot {
    background: transparent;
    border: none;
    color: #A78BFA;
    font-size: 11px;
    padding: 4px 0;
}

QPushButton#loginForgot:hover {
    color: #C4B5FD;
    text-decoration: underline;
}

#registerStatus,
#loginStatus {
    min-height: 16px;
    color: #FF5B79;
    font-size: 10.5px;
}

#registerStatus[valid="true"],
#loginStatus[valid="true"] {
    color: #34D399;
}

QPushButton#registerSubmit,
QPushButton#loginSubmit {
    min-height: 48px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#registerSubmit:hover,
QPushButton#loginSubmit:hover {
    background: #7B61FF;
}

#registerDivider,
#loginDivider {
    background: #282452;
    border: none;
}

#registerOr,
#loginOr {
    color: #8E8BA7;
    font-size: 11px;
    padding: 0 11px;
}

QPushButton#registerBack,
QPushButton#loginRegister {
    min-height: 44px;
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 12px;
    color: #C5BFDB;
    font-size: 11.5px;
}

QPushButton#registerBack:hover,
QPushButton#loginRegister:hover {
    background: #25224D;
    border-color: #6C5DD3;
    color: #FFFFFF;
}

#loginFooter {
    color: #6E6A94;
    font-size: 9px;
}

/* ========================================================================= */
/* LOGOUT MODAL DIALOG (Bo tròn 22px, phong cách SmartNet)                    */
/* ========================================================================= */
#logoutModalCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #221F48, stop:1 #14122C);
    border: 1px solid #36306D;
    border-radius: 22px;
}

QPushButton#logoutModalClose {
    background: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#logoutModalClose:hover {
    background: rgba(239, 68, 68, 0.18);
}

#logoutModalBadge {
    background: rgba(239, 68, 68, 0.14);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 34px;
}

#logoutModalTitle {
    font-size: 19px;
    font-weight: 700;
    color: #FFFFFF;
}

#logoutModalMsg {
    font-size: 13.5px;
    color: #8E8BA7;
}

#logoutAccountPill {
    background: #181533;
    border: 1px solid #2B2654;
    border-radius: 12px;
}

#logoutPillText {
    color: #8E8BA7;
    font-size: 12.5px;
}

#logoutPillText b {
    color: #FFFFFF;
}

#logoutPillText span {
    color: #A78BFA;
    font-weight: 500;
}

#logoutModalHint {
    font-size: 11.5px;
    color: #6E6A94;
}

QPushButton#logoutModalCancel {
    background: #1B1938;
    border: 1px solid #282452;
    border-radius: 12px;
    color: #C5BFDB;
    font-size: 13.5px;
    font-weight: 600;
}

QPushButton#logoutModalCancel:hover {
    background: #25224D;
    border-color: #6C5DD3;
    color: #FFFFFF;
}

QPushButton#logoutModalConfirm {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #DC2626, stop:1 #B91C1C);
    border: 1px solid #EF4444;
    border-radius: 12px;
    color: #FFFFFF;
    font-size: 13.5px;
    font-weight: 600;
}

QPushButton#logoutModalConfirm:hover {
    background: #EF4444;
    border-color: #F87171;
}
