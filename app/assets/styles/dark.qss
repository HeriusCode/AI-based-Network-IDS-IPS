* { font-family: "Segoe UI", "Inter", sans-serif; color: #F8FAFC; }
QMainWindow, #appRoot, #rightPane, #pageContent, #pageScroll { background: #0B1120; }
QScrollArea { border: none; }
QScrollBar:vertical { background: #0B1120; width: 9px; margin: 0; }
QScrollBar::handle:vertical { background: #334155; border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

#sidebar { background: #111827; border-right: 1px solid #243044; }
#brandText { font-size: 15px; font-weight: 700; line-height: 1.3; }
#sectionLabel { color: #64748B; font-size: 10px; font-weight: 700; letter-spacing: 2px; margin-left: 12px; }
#sidebarDivider { background: #293548; border: none; }
QPushButton#navButton, QPushButton#collapseButton {
    background: transparent; border: none; border-radius: 9px; color: #94A3B8;
    text-align: left; padding: 0 12px; font-size: 12px; font-weight: 600;
}
QPushButton#navButton:hover, QPushButton#collapseButton:hover { background: #1E293B; color: #F8FAFC; }
QPushButton#navButton[active="true"] { background: #1D4B83; color: #F8FAFC; }
QPushButton#navButton:focus, QPushButton#collapseButton:focus, QPushButton#iconButton:focus {
    border: 1px solid #60A5FA;
}
#collapseButton { min-height: 40px; }

#topbar { background: #111827; border-bottom: 1px solid #243044; }
#topbarTitle { font-size: 17px; font-weight: 700; }
#demoStatus, #backendStatus { border-radius: 8px; padding: 8px 10px; font-size: 10px; font-weight: 700; }
#demoStatus { background: #1D3A32; color: #4ADE80; }
#backendStatus { background: #3B2B1A; color: #FBBF24; }
#topbarClock { color: #94A3B8; font-size: 11px; padding: 0 8px; }
QPushButton#iconButton { background: #1E293B; border: 1px solid #334155; border-radius: 9px; min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; }
QPushButton#iconButton:hover { background: #334155; }

#eyebrow { color: #60A5FA; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
#pageHeading { font-size: 27px; font-weight: 700; }
#pageDescription { color: #94A3B8; font-size: 13px; }
#welcomePanel { background: #1E293B; border: 1px solid #334155; border-radius: 12px; }
#readyBadge, #phaseBadge { border-radius: 7px; padding: 7px 10px; font-size: 10px; font-weight: 700; }
#readyBadge { background: #1C4339; color: #4ADE80; }
#phaseBadge { background: #19375F; color: #93C5FD; }
#panelHeading { font-size: 23px; font-weight: 700; }
#panelDescription { color: #CBD5E1; font-size: 13px; }
#featureCard { background: #111827; border: 1px solid #27364B; border-radius: 10px; }
#featureNumber { color: #60A5FA; font-size: 11px; font-weight: 700; }
#featureName { color: #CBD5E1; font-size: 12px; font-weight: 600; }
#footerLabel { color: #64748B; font-size: 10px; font-weight: 600; letter-spacing: 1px; }
