/* ========================================================================= */
/* SYSTEM SETTINGS                                                           */
/* ========================================================================= */
#settingsHeading {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: 700;
}

#settingsSubtitle {
    color: #9E9BB5;
    font-size: 13px;
    padding-bottom: 6px;
}

QPushButton#activeSettingsTab,
QPushButton#settingsTab {
    min-height: 42px;
    border-radius: 10px;
    padding: 0 16px;
    font-size: 12.5px;
    font-weight: 600;
}

QPushButton#activeSettingsTab {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border: 1px solid #7B61FF;
    color: #FFFFFF;
}

QPushButton#settingsTab {
    background: #1B1938;
    border: 1px solid #282452;
    color: #9E9BB5;
}

QPushButton#settingsTab:hover {
    background: #25224D;
    color: #FFFFFF;
    border-color: #383466;
}

#settingsCard {
    background: #1B1938;
    border: 1px solid #2B2757;
    border-radius: 16px;
}

#settingsCardIcon {
    background: #25224D;
    border-radius: 10px;
}

#settingsCardTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
}

#settingsCardSubtitle {
    color: #9E9BB5;
    font-size: 12.5px;
}

#settingsLabel {
    color: #E2E8F0;
    font-size: 13px;
    font-weight: 600;
}

#settingsCard QLabel {
    color: #CBD5E1;
    font-size: 13px;
}

#settingsValue {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
}

QLineEdit#settingsInput,
QTextEdit#settingsText,
QComboBox#settingsCombo,
QSpinBox#settingsSpin {
    background: #15132B;
    border: 1px solid #2B2757;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 13px;
    padding: 6px 12px;
}

QLineEdit#settingsInput:focus,
QTextEdit#settingsText:focus,
QComboBox#settingsCombo:focus,
QSpinBox#settingsSpin:focus {
    border-color: #7B61FF;
}

QLineEdit#settingsInput {
    min-height: 38px;
}

QComboBox#settingsCombo,
QSpinBox#settingsSpin {
    min-height: 38px;
}

QTextEdit#settingsText {
    padding: 10px 12px;
    font-size: 13px;
    line-height: 1.4;
}

QPushButton#settingsToggle {
    border: none;
    background: transparent;
}

#settingsCard QLabel#settingsToggleState {
    color: #A78BFA;
    font-size: 12.5px;
    font-weight: 700;
}

QSlider#settingsSlider::groove:horizontal {
    height: 6px;
    background: #25224D;
    border-radius: 3px;
}

QSlider#settingsSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
    border-radius: 3px;
}

QSlider#settingsSlider::handle:horizontal {
    width: 18px;
    margin: -6px 0;
    background: #FFFFFF;
    border: 2px solid #7B61FF;
    border-radius: 9px;
}

#sliderValue {
    background: #25224D;
    border: 1px solid #383466;
    border-radius: 8px;
    color: #C4B5FD;
    padding: 5px 12px;
    font-size: 13px;
    font-weight: 700;
    min-width: 48px;
    text-align: center;
}

QPushButton#connectionTestButton {
    min-height: 38px;
    background: #25224D;
    border: 1px solid #383466;
    border-radius: 8px;
    color: #C4B5FD;
    padding: 0 16px;
    font-size: 12.5px;
    font-weight: 600;
}

QPushButton#connectionTestButton:hover {
    background: #382E72;
    border-color: #6C5DD3;
    color: #FFFFFF;
}

#connectionStatus {
    color: #34D399;
    font-size: 12.5px;
    font-weight: 600;
}

QPushButton#cardResetButton {
    min-height: 36px;
    background: #1E1B40;
    border: 1px solid #2B2757;
    border-radius: 8px;
    color: #9E9BB5;
    font-size: 12px;
    font-weight: 600;
    padding: 0 14px;
}

QPushButton#cardResetButton:hover {
    background: #2B2757;
    color: #FFFFFF;
}

QPushButton#settingsSecondaryButton,
QPushButton#saveSettingsButton,
QPushButton#applySettingsButton {
    min-height: 42px;
    border-radius: 10px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#settingsSecondaryButton {
    background: #1B1938;
    border: 1px solid #282452;
    color: #9E9BB5;
}

QPushButton#settingsSecondaryButton:hover {
    background: #25224D;
    color: #FFFFFF;
    border-color: #383466;
}

QPushButton#saveSettingsButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6C5DD3, stop:1 #8E59FF);
